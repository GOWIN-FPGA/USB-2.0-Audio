// =========================================================================
// usb_desc_UAC20_2CN.hex
// UAC 2.0 + UMS + CDC + DFU (Composite Device)
// =========================================================================

// ======================== 1. 设备描述符 (Device Descriptor) ========================
12 01           // bLength = 18 bytes, bDescriptorType = Device Descriptor
00 02           // bcdUSB version = 2.00 
EF 02 01        // bDeviceClass (Misc), bDeviceSubClass (Common), bDeviceProtocol (IAD)
40              // bMaxPacketSize0 = 64 bytes
03 04           // idVendor = 0x0403 (VENDORID)
10 60           // idProduct = 0x6010 (PRODUCTID)
00 01           // bcdDevice = 0x0100 (VERSIONBCD)
01 02 03        // iManufacturer = 1, iProduct = 2, iSerialNumber = 3
01              // bNumConfigurations = 1
00 00           // 2 bytes padding (填充)

// ======================== 2. 设备限定描述符 (Device Qualifier) ========================
0A 06           // bLength = 10 bytes, bDescriptorType = Device Qualifier
00 02           // bcdUSB = 2.00
EF 02 01        // bDeviceClass (CDC), bDeviceSubClass (none), bDeviceProtocol (none)
40              // bMaxPacketSize0 = 64 bytes
01              // bNumConfigurations = 1 
00              // bReserved
00 00           // 2 bytes padding

// ======================== 3. FS 配置描述符 (UAC 1.1) - 9 Bytes ========================
// --- 无效数据，仅做填充 ---
09 02 76 01 03 01 00 80 32              // no care

//==============================================================================
//======================== 4. HS 配置描述符 - 361 Bytes ========================
//==============================================================================
// --- 配置描述符头与 IAD ---
09 02 69 01 04 01 00 80 32 // wTotalLen = 361, 4 Interfaces
08 0B 00 02 01 00 20 02    // IAD Descriptor: 2 Interfaces, Audio/Undefined/AF 2.0

//=============  UAC2.0  ( interface 0/1/2 )
// --- Interface 0 (Audio Control) 2.0 ---
09 04 00 00 00 01 01 20 02 // Intf 0, Alt 0: Audio Control, Audio/AudioControl/AF 2.0, iInterface=2
09 24 01 00 02 04 40 00 00 // AC Header 2.0: bcdADC=2.0, bCategory=04(Headset), wTotalLen=64(0x0040)

08 24 0A 05 03 07 00 00    // AC Clock Source 2.0: ClockID=5

11 24 02 01 01 01 00 05 02 03 00 00 00 00 00 00 00 // AC Input Terminal (Speaker) 2.0: TermID=1, 2 Ch (FL, FR)
12 24 06 03 01 0F 00 00 00 0C 00 00 00 0C 00 00 00 00 // AC Feature Unit (Speaker) 2.0: UnitID=3, SourceID=1, Mute&Vol
0C 24 03 04 01 03 00 03 05 00 00 00 // AC Output Terminal (Speaker) 2.0: TermID=4, Speaker, SourceID=3, CSourceID=5

// --- Interface 1 (Speaker) 2.0 ---
09 04 01 00 00 01 02 20 04 // Intf 1, Alt 0: Speaker, 0 Endpoints, iInterface=4

// --- Interface 1.1 (Speaker)   
//PCM , 16 bits, 2 bytes/slot
09 04 01 01 02 01 02 20 00 // Intf 1, Alt 1: Speaker (16 Bit)
10 24 01 01 00 01 01 00 00 00 02 03 00 00 00 00 // AS General 2.0
06 24 02 01 02 10          // Format Type 2.0: 16 bits, 2 bytes/slot
07 05 01 05 08 03 01       // Endpoint: OUT, Iso/Asynchronous/Data, 0x0308 bytes max
08 25 01 00 00 00 00 00    // Audio Data Endpoint
07 05 81 11 04 00 04

// --- Interface 1.2 (Speaker)   
//PCM , 24 bits, 3 bytes/slot
09 04 01 02 02 01 02 20 00 // Intf 1, Alt 3: Speaker (24 Bit)
10 24 01 01 00 01 01 00 00 00 02 03 00 00 00 00 // AS General 2.0
06 24 02 01 03 18          // Format Type 2.0: 24 bits, 3 bytes/slot
07 05 01 05 08 03 01       // Endpoint: OUT, Iso/Asynchronous/Data, 0x0308 bytes max
08 25 01 00 00 00 00 00    // Audio Data Endpoint
07 05 81 11 04 00 04

// --- Interface 1.3 (Speaker)   53
//PCM , 32 bits, 4 bytes/slot
09 04 01 03 02 01 02 20 00 // Intf 1, Alt 3: Speaker (32 Bit)
10 24 01 01 00 01 01 00 00 00 02 03 00 00 00 00 // AS General 2.0
06 24 02 01 04 20          // Format Type 2.0: 32 bits, 4 bytes/slot
07 05 01 05 08 03 01       // Endpoint: OUT, Iso/Asynchronous/Data, 0x0308 bytes max
08 25 01 00 00 00 00 00    // Audio Data Endpoint
07 05 81 11 04 00 04

// --- Interface 1.4 (Speaker)    53
//DSD , 32 bits, 4 bytes/slot
09 04 01 04 02 01 02 20 00 // Intf 1, Alt 4: Speaker (32 Bit)
10 24 01 01 00 01 00 00 00 80 02 03 00 00 00 00 // AS General 2.0
06 24 02 01 04 20          // Format Type 2.0: 32 bits, 4 bytes/slot 
07 05 01 05 08 03 01       // Endpoint: OUT, Iso/Asynchronous/Data, 0x0308 bytes max
08 25 01 00 00 00 00 00    // Audio Data Endpoint
07 05 81 11 04 00 04

// --- Interface 2.0 (HID)   // 32 btye
09 04 02 00 02 03 00 00 00  // Intf3 ：HID
09 21 10 01 00 01 22 1b 00  // HID Descriptor: v1.10, 1 Report (27 bytes)
07 05 82 03 40 00 04        // Endpoint: IN (0x82), Interrupt, 512 bytes max , 1ms interval
07 05 02 03 40 00 04        // Endpoint: OUT (0x02), Interrupt, 512 bytes max, 1ms interval

// --- Intf 3.0 (DFU Runtime) //18btye 
09 04 03 00 00 FE 01 01 06 
09 21 0B FF 00 00 01 10 01 // DFU Func

// ======================== 6. 其他速率配置与 HID 描述符 ========================
07              // Other Speed Configuration Descriptor (1 Byte)

// --- HID Report Descriptor (27 Bytes) ---
05 01 09 00 A1 01 15 00 25 FF 19 01 29 08 95 10 
75 08 81 02 19 01 29 08 91 02 c0

// ======================== 7. 字符串描述符 (String Descriptors) ========================
04 03 09 04     // String 0: Supported Languages (0x0409 = English U.S.)
14 03 47 00 6F 00 77 00 69 00 6E 00 73 00 65 00 6D 00 69 00 // String 1 (Vendor): "Gowinsemi"
2A 03 55 00 53 00 42 00 20 00 43 00 6F 00 6D 00 70 00 6F 00 73 00 69 00 74 00 65 00 20 00 44 00 65 00 76 00 69 00 63 00 65 00 // String 2 (Product): "USB Composite Device"
0A 03 54 00 45 00 53 00 54 00           // String 3 (Serial): "TEST"
// STR4: "UAC HIFI 2CN" (26 bytes)
1A 03 55 00 41 00 43 00 20 00 48 00 49 00 46 00 49 00 20 00 32 00 43 00 4E 00

// STR5: "HID Interface" (28 bytes)
1C 03 48 00 49 00 44 00 20 00 49 00 6E 00 74 00 65 00 72 00 66 00 61 00 63 00 65 00

// STR6: "DFU Runtime" (24 bytes)
18 03 44 00 46 00 55 00 20 00 52 00 75 00 6E 00 74 00 69 00 6D 00 65 00

// ======================== 7. DFU Mode Device/Config (When i_dfu_mode=1) ========================
// --- DFU Mode Device Descriptor (18 bytes) ---
12 01 00 02 00 00 00 40 03 04 01 FE 00 01 01 02 03 01 

// --- DFU Mode Config Descriptor (27 bytes) ---
09 02 1B 00 01 01 00 80 32
09 04 00 00 00 FE 01 02 06 
09 21 0B FF 00 00 02 10 01